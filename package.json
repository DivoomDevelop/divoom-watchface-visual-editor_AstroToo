{
  "name": "divoom-watchface-visual-editor-astrotoo",
  "productName": "AstroToo Watchface Editor",
  "version": "0.1.0",
  "description": "Divoom AstroToo watchface visual editor (480×480)",
  "author": "DivoomDevelop",
  "main": "desktop/main.cjs",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/DivoomDevelop/divoom-watchface-visual-editor_AstroToo.git"
  },
  "bugs": {
    "url": "https://github.com/DivoomDevelop/divoom-watchface-visual-editor_AstroToo/issues"
  },
  "homepage": "https://github.com/DivoomDevelop/divoom-watchface-visual-editor_AstroToo",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run gen:ai-docs",
    "build": "vite build",
    "preview": "vite preview",
    "desktop:start": "vite build && electron .",
    "desktop:make": "vite build && electron-builder --config electron-builder.config.cjs",
    "desktop:make:win": "vite build && electron-builder --config electron-builder.config.cjs --win nsis --x64",
    "desktop:make:mac": "vite build && electron-builder --config electron-builder.config.cjs --mac dmg",
    "gen:ai-docs": "node scripts/gen-ai-docs.mjs",
    "sync:disp": "node scripts/sync-disp-from-simulator.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "install:git-hooks": "node scripts/install-git-hooks.mjs",
    "prepare": "node scripts/install-git-hooks.mjs",
    "lan:probe": "node scripts/lan-probe.mjs"
  },
  "devDependencies": {
    "electron": "41.3.0",
    "electron-builder": "^26.15.3",
    "http-proxy": "^1.18.1",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "@jsquash/jpeg": "^1.6.0"
  }
}
